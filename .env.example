# 运行环境与日志。APP_ENV 可选 dev 或 prod。
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=./logs

# 本地 Docker。覆盖端口时同步修改下方连接地址。
DEV_POSTGRES_PASSWORD=postgres
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379

# 前端、后端与文档 Sidecar 的本地监听配置
COLLAB_WEB_PORT=5173
KB_WEB_PORT=5174
COLLAB_SERVER_HOST=127.0.0.1
COLLAB_SERVER_PORT=8000
KB_SERVER_HOST=127.0.0.1
KB_SERVER_PORT=8001
DOCX_SIDECAR_HOST=127.0.0.1
DOCX_SIDECAR_PORT=3000
DOCX_SIDECAR_BASE_URL=http://127.0.0.1:3000

# PostgreSQL 业务连接。app_user 为 NOSUPERUSER、NOBYPASSRLS，受 FORCE ROW LEVEL SECURITY 约束。
COLLAB_DATABASE_URL=postgresql+asyncpg://app_user:postgres@127.0.0.1:5432/collab_dev
KB_DATABASE_URL=postgresql+asyncpg://app_user:postgres@127.0.0.1:5432/kb_dev

# Alembic DDL 与管理连接。postgres 在 public 中创建的对象会按默认权限授权给 app_user。
COLLAB_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/collab_dev
KB_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/kb_dev

# Redis 与 Celery 队列
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 账号认证与服务间鉴权。生产环境必须替换开发密钥并配置服务 API Key。
JWT_SECRET_KEY=dev-only-change-me-in-production-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# 本机文档 Sidecar 使用 X-Internal-Secret。
INTERNAL_SIDECAR_SECRET=dev-only-change-me-internal-sidecar-secret
# collab-server 调用 kb-server 时使用 X-KB-API-Key。
KB_OPEN_API_BASE_URL=http://127.0.0.1:8001
KB_SERVICE_API_KEY=

# 私有对象存储。开发环境可用 local 模拟，oss 使用阿里云私有 Bucket。
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.storage
STORAGE_PRESIGN_EXPIRE_SECONDS=900
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ModelHub 默认配置。研发测试使用阿里云百炼，生产使用私有化 OpenAI 兼容接口。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Arize Phoenix 链路追踪。默认使用本地 PostgreSQL 的 phoenix 库。
PHOENIX_ENABLED=true
PHOENIX_PORT=6006
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_SQL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/phoenix
