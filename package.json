{
  "name": "aegistondoc",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --filter docx-sidecar run --parallel dev",
    "build": "pnpm --filter \"./apps/*\" --filter docx-sidecar run build",
    "lint": "oxlint",
    "format": "oxfmt --write \"**/*.{ts,tsx,mts}\"",
    "test": "vitest run",
    "codegen": "pnpm --filter \"@workspace/api-client\" run codegen"
  },
  "devDependencies": {
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "vite": "^8",
    "vitest": "^5.1.0"
  }
}