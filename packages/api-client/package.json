{
  "name": "@workspace/api-client",
  "private": true,
  "type": "module",
  "exports": {
    "./collab": "./src/collab/index.ts",
    "./kb": "./src/kb/index.ts",
    "./collab/query": "./src/collab/@tanstack/react-query.gen.ts",
    "./kb/query": "./src/kb/@tanstack/react-query.gen.ts",
    "./collab/zod": "./src/collab/zod.gen.ts",
    "./kb/zod": "./src/kb/zod.gen.ts"
  },
  "scripts": {
    "codegen": "pnpm run codegen:collab && pnpm run codegen:kb",
    "codegen:collab": "openapi-ts -i http://127.0.0.1:8000/openapi.json -o src/collab -p @hey-api/typescript @hey-api/sdk @hey-api/client-axios @tanstack/react-query zod",
    "codegen:kb": "openapi-ts -i http://127.0.0.1:8001/openapi.json -o src/kb -p @hey-api/typescript @hey-api/sdk @hey-api/client-axios @tanstack/react-query zod"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "axios": "^1",
    "zod": "^4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "~6.0.3"
  }
}
